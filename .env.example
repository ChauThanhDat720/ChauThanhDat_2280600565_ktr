# Copy to .env, replace these values, then load it in your shell.
Bootstrap__AdminUsername=admin
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword='REPLACE_WITH_YOUR_OWN_PASSWORD'

# Leave SMTP Host empty only for local Development email pickup.
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__From=attendance@example.com
Smtp__Username=
Smtp__Password=
